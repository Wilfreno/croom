{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    ".github/workflows/test.yml"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "UPLOADTHING_TOKEN"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "dist-cjs/**"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
