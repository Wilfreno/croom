{
  "name": "@repo/utils",
  "main": "dist-cjs/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput & tsc -p tsconfig.cjs.json --watch --preserveWatchOutput & wait",
    "build": "tsc && tsc -p tsconfig.cjs.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist-cjs/index.js"
    }
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "latest",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@nestjs/config": "^4.0.4"
  },
  "dependencies": {
    "@repo/constants": "workspace:*",
    "@repo/enums": "workspace:*",
    "@repo/schemas": "workspace:*",
    "mongoose": "^8.8.3",
    "zod": "^4.4.3"
  }
}
